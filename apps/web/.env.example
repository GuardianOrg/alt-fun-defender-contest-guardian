# Vite env for the web app. Copy to `.env.local` and fill in placeholders
# marked with `ASK_A_TEAMMATE`. Both files are gitignored.

# HyperEVM chain id.
VITE_CHAIN_ID=999

# HyperEVM RPC (mainnet). Shared dev key lives with the team.
VITE_RPC_URL=ASK_A_TEAMMATE

# Ponder GraphQL URL (local default).
VITE_PONDER_URL=http://localhost:42069

# API base URL (local default).
VITE_API_URL=http://localhost:8787

# WebSocket URL for live chart/feed updates (local default).
# Must match the API host. In prod this should be `wss://<api-host>/ws`.
VITE_WS_URL=ws://localhost:8787/ws

# Privy app id. Shared dev app id lives with the team.
VITE_PRIVY_APP_ID=ASK_A_TEAMMATE

# Optional dev override for the geo-block hook (`useIsGeoBlocked`). Localhost
# has no Cloudflare edge in front of it, so `/cdn-cgi/trace` returns nothing
# useful — set this to an ISO 3166-1 alpha-2 code (e.g. `GB`, `US`) to
# simulate a country and exercise the geo-block banner. Leave unset in
# production; trace works for free on the Cloudflare Pages deploy.
# VITE_GEO_COUNTRY_OVERRIDE=GB
