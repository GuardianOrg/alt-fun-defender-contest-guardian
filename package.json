{
  "name": "launchpad-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "cp -r apps/indexer/node_modules/react node_modules/ink/node_modules/react 2>/dev/null || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "turbo run lint typecheck test build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "ink": {
      "react": "^18.2.0"
    }
  }
}
