# Foundry contract deploy environment.
# Only needed if you're deploying contracts. Skip this file if you're just
# running the webapp locally — `packages/shared` already ships the deployed
# addresses for HyperEVM.
#
# Copy to `.env` and fill in placeholders marked with `ASK_A_TEAMMATE`.
# Both files are gitignored.

# Deployer EOA private key (0x-prefixed). Ask a teammate for the shared
# dev/staging key, or use your own for personal testnets.
DEPLOYER_PRIVATE_KEY=ASK_A_TEAMMATE

# HyperEVM RPC (mainnet). Any Alchemy/Infura/public endpoint works.
HYPEREVM_RPC_URL=ASK_A_TEAMMATE
