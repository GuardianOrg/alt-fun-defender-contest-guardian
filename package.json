{
  "name": "launchpad-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-ink-react.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "turbo run lint typecheck test build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  },
  "overrides": {
    "viem": "~2.47.12",
    "wagmi": "3.6.1"
  },
  "packageManager": "npm@10.9.7"
}
