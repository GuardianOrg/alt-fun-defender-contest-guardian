# Cloudflare Worker local dev secrets for `wrangler dev`.
# Copy to `.dev.vars` and fill in placeholders marked with `ASK_A_TEAMMATE`.
# Both files are gitignored.

# Neon PostgreSQL — off-chain app DB (profiles, tokens metadata).
DATABASE_URL=ASK_A_TEAMMATE

# Neon PostgreSQL — BounceTech read-only snapshot DB (LT exchange rates).
BOUNCETECH_DATABASE_URL=ASK_A_TEAMMATE

# Shared key used by the API to authenticate admin endpoints AND by the
# indexer to authenticate its trade webhook calls. Must match the indexer's
# ADMIN_API_KEY. `dev-admin-key` is fine for local; prod uses a CF secret.
ADMIN_API_KEY=dev-admin-key

# Comma-separated list of admin wallet addresses authorised to perform
# wallet-signed moderation actions (e.g. hiding a token from the public
# listings via the front-end UI — see `routes/moderation.ts`). Whitespace
# around each address is tolerated; case-insensitive. Leave unset to fall
# back to `DEFAULT_ADMIN_WALLETS` from `@launchpad/shared` (which already
# ships with the canonical admin baked in, so you don't need this in dev
# unless you want to test with a different signer).
ADMIN_WALLETS=

# Graduation keeper hot-wallet private key (`0x…`). Drives phase 2 of the
# two-phase graduation flow — the worker calls `Bonding.finalizeGraduation`
# from this account once a token enters the `pendingGraduation` window.
# Setup:
#   1. Generate a fresh key — never reuse the deployer key.
#   2. Fund with ~5 HYPE for gas (each finalize is ~2.5M big-block gas).
#   3. Toggle big blocks ON for the keeper wallet (sticky per-wallet on
#      Hyperliquid L1):
#        DEPLOYER_PRIVATE_KEY=<this key> node packages/contracts/scripts/toggle-big-blocks.mjs on
#   4. `wrangler secret put KEEPER_PRIVATE_KEY` for prod.
# Leave blank in local dev to disable the keeper (cron will log a warn).
KEEPER_PRIVATE_KEY=

# Optional override for the HyperEVM RPC URL. Defaults to the public RPC.
# Shared by the finalize keeper and the auto-graduation buyer.
HYPEREVM_RPC_URL=

# Auto-graduation buyer hot-wallet private key (`0x…`). Distinct from the
# finalize `KEEPER_PRIVATE_KEY` above — this wallet must stay on **small
# blocks** so its sub-second buys/sells aren't queued behind the finalize
# keeper's ~60s big-block confirmations. Drives phase 1 for tokens whose
# raised-LT crossed the USD threshold purely from LT price appreciation
# (no user buy in the loop) and unwinds the resulting position once
# phase 2 finalises.
# Setup:
#   1. Generate a fresh key — never reuse `KEEPER_PRIVATE_KEY` or the
#      deployer key. Two keepers, two wallets, two block-size settings.
#   2. Fund with HYPE for gas + ~$120 USDC of in-flight capital
#      (5 buys × $20 trigger amount per tick, plus a cushion for
#      positions awaiting phase 2 finalize).
#   3. Leave big blocks OFF (default). If the wallet was ever toggled,
#      run `toggle-big-blocks.mjs off` before deploying the secret.
#   4. `wrangler secret put AUTO_GRADUATION_BUYER_PRIVATE_KEY` for prod.
# Leave blank in local dev to disable the keeper (cron will log a warn).
AUTO_GRADUATION_BUYER_PRIVATE_KEY=

# OpenAI API key for image moderation (token-logo uploads). Drives the
# `omni-moderation-latest` call in `apps/api/src/lib/image-moderation.ts`.
# OpenAI's moderation endpoint is free but a valid key is still required
# for auth.
# Setup:
#   1. Create at https://platform.openai.com/api-keys. Apply least-privilege
#      permissions per your org's key-restriction model — endpoint-based
#      restrictions (Write on `/v1/moderations`) for restricted keys, or
#      the equivalent RBAC role if the project uses RBAC.
#   2. `wrangler secret put OPENAI_API_KEY` for prod / preview.
# Leaving blank in dev causes every image upload to 503 with
# "moderation temporarily unavailable" — fail-closed by design.
OPENAI_API_KEY=
