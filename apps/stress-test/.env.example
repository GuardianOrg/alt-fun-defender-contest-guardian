# Hex private key (with or without 0x prefix) for the wallet that will sign
# every stress-test transaction. MUST be funded with HYPE (gas) and USDC.
# Treat this as production-credential-grade — never commit a real key.
STRESS_TEST_PRIVATE_KEY=

# HyperEVM RPC endpoint. Defaults to the public node if blank; for any real
# load test point this at a private Alchemy / Infura RPC to avoid rate-limit
# saturation under concurrency.
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Alt Fun API base URL. Local dev: http://localhost:8787. Staging / prod:
# the deployed Worker URL.
API_BASE_URL=http://localhost:8787

# Optional — required only when hitting a deployed API (non-localhost).
# Mint one in the admin dashboard / DB and paste it here. Localhost bypasses
# auth so this can stay blank for `npm run dev` against `apps/api`.
STRESS_TEST_API_KEY=
