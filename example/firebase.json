{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/register",
        "function": "register"
      },
      {
        "source": "/api/inviteCodes",
        "function": "inviteCodes"
      },
      {
        "source": "/api/hasRegistered",
        "function": "hasRegistered"
      },
      {
        "source": "/api/addressHasRegistered",
        "function": "addressHasRegistered"
      },
      {
        "source": "/api/inviteCodeUsed",
        "function": "inviteCodeUsed"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
