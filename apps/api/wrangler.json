{
  "name": "launchpad-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {},
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "launchpad-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WALLET_KV",
      "id": "25ca96dbbc9043899a87afc55654f1c5"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET_DO",
        "class_name": "WebSocketDO"
      },
      {
        "name": "LT_TICKER_DO",
        "class_name": "LtTicker"
      },
      {
        "name": "WS_IP_LIMITER_DO",
        "class_name": "WsIpLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["WebSocketDO"]
    },
    {
      "tag": "v2",
      "new_classes": ["LtTicker"]
    },
    {
      "tag": "v3",
      "new_classes": ["WsIpLimiter"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
