# Ponder indexer environment for local dev.
# Copy to `.env.local` and fill in placeholders marked with `ASK_A_TEAMMATE`.
# Both files are gitignored.

# HyperEVM RPC (chain id 999). Ponder reads this via the PONDER_RPC_URL_<id>
# convention. Shared dev key lives with the team.
PONDER_RPC_URL_999=ASK_A_TEAMMATE

# Local API base URL. The indexer POSTs live trade events to
# `${API_WEBHOOK_URL}/api/v1/webhook/indexer`. If unset, live broadcasts are
# silently skipped — indexing still works, but WS chart updates won't fire.
API_WEBHOOK_URL=http://localhost:8787

# Must match the API's ADMIN_API_KEY (see apps/api/.dev.vars). Used to auth
# the webhook call.
ADMIN_API_KEY=dev-admin-key
