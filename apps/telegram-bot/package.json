{
  "name": "@launchpad/telegram-bot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9230",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:webhook": "./scripts/register-webhook.sh",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/storage-cloudflare": "^2.4.2",
    "@launchpad/shared": "*",
    "@resvg/resvg-wasm": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.42.0",
    "hono": "^4.12.14",
    "viem": "^2.47.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@launchpad/config": "*",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
