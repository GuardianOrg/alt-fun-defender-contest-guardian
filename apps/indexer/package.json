{
  "name": "@launchpad/indexer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "ponder start --hostname 0.0.0.0 --schema=$RAILWAY_DEPLOYMENT_ID --views-schema=ponder_views",
    "serve": "ponder serve",
    "codegen": "ponder codegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@launchpad/shared": "*",
    "hono": "^4.13.5",
    "ponder": "^0.17",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@launchpad/config": "*",
    "@types/node": "^25.6.0",
    "typescript": "~6.0.3",
    "vitest": "^4"
  }
}
